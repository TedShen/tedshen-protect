---
// 法定揭露區塊。每一頁都放，位置在頁尾 CTA 之後、footer 之前。
// 文字內容全部來自 consts.ts 的 DISCLOSURE，這裡不寫死任何一個字。
import { DISCLOSURE, PERSON } from '../consts';
---

<section class="wrap" aria-label="法定揭露">
  <div class="compliance-note" style="font-size:.85rem; line-height:1.8;">
    <p style="color:var(--text); font-weight:600; margin-bottom:6px;">業務員登錄資料</p>
    <p>姓名：{PERSON.name}</p>
    <p>登錄公司：{DISCLOSURE.companyName}</p>
    {DISCLOSURE.registrationNo && <p>登錄字號：{DISCLOSURE.registrationNo}</p>}
    {DISCLOSURE.qualifications?.length > 0 && <p>登錄資格：{DISCLOSURE.qualifications.join('、')}</p>}
    <p>查證：業務員登錄資料可向登錄公司查詢。</p>
    {DISCLOSURE.reviewNo && <p>審核編號：{DISCLOSURE.reviewNo}</p>}
    <p style="margin-top:10px;">{DISCLOSURE.statement}</p>
  </div>
</section>
