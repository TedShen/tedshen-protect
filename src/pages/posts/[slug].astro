---
// 客戶版保險文章頁。自動帶：延伸閱讀（若有 relatedNote）、CTA、法定揭露。
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import { LINE_URL, PERSON } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, relatedNote, image } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });

// 文章頁 BlogPosting 結構化資料
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: PERSON.name },
};
---

<Base
  title={`${title} ｜ Ted 保險服務`}
  description={description}
  path={`/posts/${post.id}/`}
  type="article"
  image={image ?? '/og.jpg'}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  breadcrumbs={[{ name: '文章', path: '/posts/' }, { name: title, path: `/posts/${post.id}/` }]}
  schema={blogSchema}
>
  <article class="wrap prose" style="padding-top:80px;">
    <p class="post-meta">
      <time datetime={pubDate.toISOString().slice(0, 10)}>{fmt(pubDate)}</time>
      {updatedDate && <>・更新於 <time datetime={updatedDate.toISOString().slice(0, 10)}>{fmt(updatedDate)}</time></>}
    </p>
    <h1>{title}</h1>
    {tags.length > 0 && <p class="post-meta">{tags.map((t) => <span class="tag">#{t}</span>)}</p>}

    <div style="margin-top:32px;">
      <Content />
    </div>

    {relatedNote && (
      <p class="compliance-note" style="margin-top:40px;">
        延伸閱讀：這個主題我在個人筆記裡也寫過純觀念的版本，不涉及商品。
        <a href={relatedNote} style="color:var(--brand-dark);">看那一篇 →</a>
      </p>
    )}

    <p style="margin-top:40px;"><a class="back-link" href="/">← 回首頁</a></p>
  </article>

  <section class="wrap">
    <div class="cta">
      <h2>想聊聊你的保障狀況？</h2>
      <p>第一次整理不收費，也不需要決定任何事。</p>
      <a class="btn btn-line" href={LINE_URL}>加 LINE 預約整理 →</a>
    </div>
  </section>

  <Disclosure />
</Base>
